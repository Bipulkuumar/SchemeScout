# Backend environment variables
# Copy this file to .env and fill in your values

# Server port (Render sets this automatically in production)
PORT=5000

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/schemescout?retryWrites=true&w=majority

# (Optional) Google Gemini API key for AI-powered scheme ranking
# Get this from: https://aistudio.google.com/app/apikey
# Leave blank to use rule-based matching only
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS (your Vercel deployment URL in production)
# Development: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
